@startuml
skinparam defaultFontName "GOST type B"
skinparam monochrome true
skinparam shadowing false
start
repeat
 :Запросить актуальные курсы;
 if (Данные получены?) then (нет)
  :Показать ошибку и предложить повтор;
 endif
repeat while (Ошибка источника?) is (да) not (нет)
:Показать курсы, источник и время обновления;
repeat
 :Выбрать валюты и ввести сумму;
 if (Ввод корректен?) then (нет)
  :Показать ошибку ввода;
 endif
repeat while (Ввод некорректен?) is (да) not (нет)
:Рассчитать и показать результат конвертации;
:Выбрать валюту и период графика;
:Получить историю изменений курса;
if (Есть исторические данные?) then (да)
 :Построить график курса;
else (нет)
 :Сообщить об отсутствии данных за период;
endif
repeat
 :Ввести данные для входа;
 if (Вход выполнен?) then (нет)
  :Сообщить об ошибке входа;
 endif
repeat while (Ошибка входа?) is (да) not (нет)
:Открыть личные настройки уведомлений;
repeat
 :Выбрать валюту и задать порог;
 if (Параметры корректны?) then (нет)
  :Показать ошибку параметров;
 endif
repeat while (Параметры некорректны?) is (да) not (нет)
:Сохранить и включить правило уведомления;
repeat
 repeat
  :Получить новый и предыдущий курсы;
  if (Курсы доступны?) then (нет)
   :Показать ошибку обновления;
  endif
 repeat while (Ошибка получения?) is (да) not (нет)
 if (Порог достигнут и дата ещё не обработана?) then (да)
  :Создать уведомление в личном списке;
 else (нет)
  :Продолжить без нового уведомления;
 endif
repeat while (Приложение открыто?) is (да) not (нет)
stop
@enduml
